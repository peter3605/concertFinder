# Spotify OAuth client ID (developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=

# OAuth callback. localhost is rejected by Spotify; use the literal IP for dev.
SPOTIFY_REDIRECT_URI=https://127.0.0.1:3000/api/auth/callback

# Ticketmaster Discovery API key (developer.ticketmaster.com).
TICKETMASTER_API_KEY=

# Postgres connection string, as seen FROM THE HOST — port 5433, because
# docker-compose.yml publishes the db container's 5432 on 5433 to avoid
# colliding with any local Postgres. This is the value the `go run ./cmd/server`
# flow in docs/local-dev.md needs.
#
# It is deliberately not db:5432: when the api runs inside compose it never
# reads this line at all, because docker-compose.yml sets DATABASE_URL in the
# api service's `environment:` block, which takes precedence over env_file.
#
# LOCAL DEV ONLY. Production is Neon, not the compose `db` service and no longer
# RDS, so the production value is a Neon connection string:
#
#   DATABASE_URL=postgres://neondb_owner:<pw>@<ep>.<region>.aws.neon.tech/neondb?sslmode=require
#
# `neondb_owner` and `neondb` are Neon's defaults and nothing in the code cares
# what either is called — the migrations create tables inside whatever database
# the URL points at, and never create a database. They differ from the RDS
# setup's `concertfinder`/`concertfinder` purely because Neon named them.
#
# Two things about that string are load-bearing:
#   - Use the DIRECT endpoint, not the pooled one. River picks jobs up via
#     LISTEN/NOTIFY, and Neon's pooled endpoint is PgBouncer in transaction
#     mode, which does not support it — and does not say so. Job pickup silently
#     degrades to the 1s FetchPollInterval fallback and leader resignations take
#     ~5s to notice.
#   - Keep ?sslmode=require. Traffic to Neon crosses the public internet now
#     rather than sitting inside the VPC, and this is what replaces the
#     `rds.force_ssl=1` parameter group the RDS instance used to enforce.
DATABASE_URL=postgres://concertfinder:concertfinder@127.0.0.1:5433/concertfinder?sslmode=disable

# 32 bytes hex-encoded; generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# HMAC key for CSRF and unsubscribe tokens. Optional: when blank it is derived
# from ENCRYPTION_KEY with a domain separator. Set it explicitly if you ever
# want to rotate signing without invalidating stored refresh-token ciphertexts
# (rotating it logs everyone's CSRF tokens and live unsubscribe links out).
# 32 bytes hex-encoded; generate with: openssl rand -hex 32
SIGNING_KEY=

# Cookie domain. 127.0.0.1 for local dev (must match Spotify redirect host).
SESSION_COOKIE_DOMAIN=127.0.0.1

# Bind address for the Go API.
LISTEN_ADDR=:8080

# Fallback location, used for any user with no row in user_locations (design
# §10.1). Defaults are NYC / 50 miles.
#
# This is a real city that is almost certainly not the user's, and it is not
# only cosmetic: jobs.FallbackLocation reads the same value, so the nightly
# fanout *scans* here for location-less users. GET /api/me/location marks these
# responses `is_default: true` so the frontend can tell "somewhere I picked"
# from "wherever this deployment is configured for", and asks the browser for
# real coordinates once on first login. A user who declines keeps these values,
# so set them to something plausible for your users rather than leaving NYC.
USER_LATITUDE=40.7128
USER_LONGITUDE=-74.0060
USER_RADIUS_MILES=50

# --- Phase 2 (small-artist fallback chain, design §5.4) ---

# Set to "1" or "true" to enable Tier A/B fallbacks for high-affinity artists
# Ticketmaster returns empty for. Since Bandsintown was removed this chain is
# the only secondary source, so it now carries every artist TM doesn't cover
# rather than only those neither primary knew about — worth revisiting
# PHASE2_MIN_SCORE and PHASE2_FALLBACK_BUDGET_SECONDS below against how much
# small-artist coverage you actually want.
PHASE2_FALLBACKS_ENABLED=false

# Only artists with affinity score >= this threshold escalate to fallbacks.
# 2.0 filters out casual signals; tune based on your affinity distribution.
PHASE2_MIN_SCORE=2.0

# Total wall-clock the fallback chain may spend per scan, across all artists.
# The chain's lookups (MusicBrainz, Nominatim) are globally serialized at
# 1 req/sec, so their cost scales with the number of escalating artists, not
# with parallelism — on a cold 200-artist profile that measured ~250s of
# MusicBrainz plus ~86s of Nominatim, against a 300s ScanBudget. Unbounded,
# the fallback eats the whole scan and starves the Ticketmaster fan-out
# that produces most results.
# Raised from 60s when Bandsintown was removed: a measured 200-artist scan at
# 60s logged artists_not_escalated=34, meaning a sixth of the profile got no
# secondary lookup at all. That was survivable when BIT was a second primary;
# with Ticketmaster alone those artists just don't appear, and silently —
# budget exhaustion is deliberately not counted as scan incompleteness.
#   unset/0 = 120s default;  negative = disable the fallback entirely
PHASE2_FALLBACK_BUDGET_SECONDS=120

# How many scans may use the fallback chain at once, process-wide.
# The budget above is per-scan wall-clock, but MusicBrainz and Nominatim each
# sit behind a single shared 1 req/sec turnstile — so letting every concurrent
# scan in splits that throughput without shrinking anyone's budget, and
# coverage silently thins as users are added (~55 lookups solo vs ~11 each at
# five-way concurrency). 1 matches the turnstiles. <= 0 removes the limit.
PHASE2_FALLBACK_CONCURRENCY=1

# URL resolution for Tier B (search → JSON-LD scrape) defaults to MusicBrainz
# (free, no API key). Only set BRAVE_SEARCH_API_KEY if you specifically want
# to override with Brave Search — signup at https://api.search.brave.com/.
BRAVE_SEARCH_API_KEY=

# TODO: register at https://www.songkick.com/developer and paste key here.
# Without this, the Songkick tier is skipped.
SONGKICK_API_KEY=

# --- Phase 3 (SWR snapshot + per-user rate accounting + email digest) ---

# How stale a snapshot can be before a request triggers a background refresh.
# 0/unset defaults to 6h.
SNAPSHOT_STALE_AFTER_HOURS=6

# UTC hour for each of the four daily background jobs. These are wall-clock
# times, not intervals: river's periodic scheduler holds in-memory state and
# re-anchors to process start, so a 24h interval drifts to a new time of day
# after every deploy and — because the jobs don't run on start — never fires
# at all on a process that restarts more than once a day. Deploys restart the
# server on every push to main, so that was a real hole.
#
# DAILY_DIGEST_HOUR_UTC must trail DAILY_SCAN_HOUR_UTC by at least 2 hours.
# The digest emails whatever the scan wrote, and the scan fanout smears its
# per-user jobs over 60 minutes with a 5-minute budget and retries on top. Run
# them together and every digest silently describes the previous day's scan.
# The server warns at startup when the gap is too small.
#
# Out-of-range values (not 0-23) fall back to the defaults below.
DAILY_AFFINITY_HOUR_UTC=6
DAILY_SCAN_HOUR_UTC=7
DAILY_DIGEST_HOUR_UTC=9
DAILY_JANITOR_HOUR_UTC=10

# How long cached per-artist upstream responses stay trusted. This is the
# main lever on how much quota a user costs: a scan covers 200 artists, so
# every cache expiry costs roughly one call per artist per source. At the old
# 4h the cache lapsed several times a day and scans ran out of quota partway,
# returning a fraction of a user's shows. Must stay above
# SNAPSHOT_STALE_AFTER_HOURS (so SWR refreshes are served from cache) and
# below the janitor's 7-day prune. 0/unset defaults to 12h.
CONCERT_CACHE_TTL_HOURS=12

# Per-user daily caps on outbound API calls to protect shared upstream quotas
# (design §8.3). 0 disables the cap for that source.
#
# Size these against the 200 artists in a scan, NOT just the shared-account
# ceiling: a cap below the artist count means a user can never cover their own
# profile and every scan reports itself incomplete.
#
# Size for a COLD scan, not a warm one. Ticketmaster resolution is two-stage
# (name -> attractionId, then events by that ID), so a warm cache costs ~1 call
# per artist but a first-ever scan costs ~2 -- roughly 400 for 200 artists. 250
# was set from the warm number and the very first real scan died at exactly
# 250/250 having covered ~125 artists, writing a snapshot with 65 shows and
# complete=false. It does not self-heal quickly either: the next day still
# needs 70x2 + 130x1 = 270. Positive resolutions never expire, so the extra
# allowance is only spent on cold starts and genuinely new artists.
#
# Trade-off: Ticketmaster's account-wide budget is 5000/day, so 500 per user
# supports ~10 concurrently active users rather than ~20.
RATE_CAP_TM_PER_USER_DAILY=500
RATE_CAP_SONGKICK_PER_USER_DAILY=100

# Account-wide daily ceilings. These are the numbers the upstream actually
# enforces — Ticketmaster's 5000/day is per API key, not per user of ours — so
# without them the per-user caps simply multiply: ten users at 500 is the whole
# allowance, and the eleventh user's scan gets upstream 403s that arrive
# looking exactly like an artist with no shows.
#
# Divide the account cap by the per-user cap to get how many full cold scans a
# day holds; the server logs that number at startup. Raise the account cap only
# if the upstream allowance actually went up — setting it above the real quota
# does not buy requests, it just moves where the failure happens from a counter
# we control to a 403 we cannot see.
RATE_CAP_TM_ACCOUNT_DAILY=5000
RATE_CAP_SONGKICK_ACCOUNT_DAILY=5000

# Email digest delivery. "log" writes to slog instead of sending — safe for
# local dev with no SMTP config. "smtp" uses the SMTP_* vars.
EMAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Public base URL for outgoing email links (unsubscribe, etc). Local dev
# defaults to https://127.0.0.1:3000.
SITE_BASE_URL=

# Bare apex domain this deployment serves, e.g. concerts.example.com — no
# scheme, no path. PRODUCTION ONLY; leave blank for local dev, which runs no
# Caddy at all (docker-compose.yml has no caddy service).
#
# This one is read by Caddy, not by the Go binary: docker-compose.prod.yml
# passes the same .env to the caddy container, whose site block is literally
# `{$SITE_DOMAIN} {`. Left unset in production it expands to nothing, that
# line collapses into a *global options block*, and Caddy exits with
# "unrecognized global option: encode" — which `restart: unless-stopped` turns
# into a crash loop, with no TLS, no site, and a perfectly healthy-looking api
# container beside it.
#
# It must also match the host in SITE_BASE_URL above, or Caddy provisions a
# certificate for one name while every emailed link and the
# MusicBrainz/Nominatim User-Agent point at another. The server checks both at
# startup (config.Validate) and refuses to boot, because neither failure is
# visible from inside the app and CI cannot see this file.
SITE_DOMAIN=

# Operator contact on /privacy and /terms pages.
CONTACT_EMAIL=peter.ho433@gmail.com

# S3 bucket for nightly pg_dump artifacts, from `terraform output backup_bucket`.
# PRODUCTION ONLY; leave blank for local dev. Read by scripts/backup-db.sh on
# the instance, never by the Go binary — which is why config.Validate does not
# check it and an empty value here fails at 03:00 in a systemd timer instead of
# at boot. Neon's free plan keeps a much shorter restore history than the 7-day
# RDS retention this deployment used to have, so these dumps are the actual
# backstop for the encrypted Spotify refresh tokens in `users`.
BACKUP_S3_BUCKET=

# ---------------------------------------------------------------------------
# iOS client (docs/ios-app-plan.md Appendix A)
#
# Every variable below is optional. A deployment with none of them set serves
# the web app exactly as before: /login?client=ios is refused, the
# apple-app-site-association file 404s, and the push worker no-ops. What is
# NOT allowed is a partial APNs set — config.Validate rejects that at startup,
# because a half-configured push path wires up successfully and then silently
# drops every notification, which looks identical to "nobody has opted in".
# ---------------------------------------------------------------------------

# APNs authentication key, from the Apple Developer portal (Keys → new key with
# "Apple Push Notifications service" enabled). Token-based auth: one key covers
# every app in the team and does not expire annually the way a push certificate
# does.
APNS_KEY_ID=
APNS_TEAM_ID=

# The app's bundle identifier, e.g. com.example.concertfinder. Also the APNs
# topic, and the second half of IOS_APP_ID below.
APNS_BUNDLE_ID=

# The PEM *contents* of the .p8 file, not a path — it travels as an SSM
# SecureString like every other secret here. Newlines may be escaped as \n.
# Never logged.
APNS_P8_KEY=

# Which APNs host to send to. Must match the build's aps-environment
# entitlement: a token minted by a debug/TestFlight build is rejected by the
# production host as BadDeviceToken, and a production token sent to the sandbox
# host reaches nobody while reporting success. Defaults to production.
APNS_ENVIRONMENT=production

# "<TeamID>.<BundleID>", served in apple-app-site-association so iOS will
# associate this domain with the app. Derived from APNS_TEAM_ID and
# APNS_BUNDLE_ID when left blank.
IOS_APP_ID=

# The universal link /api/auth/callback redirects to after an app-initiated
# login. Must be https and must be on the same host as SITE_BASE_URL — iOS
# fetches the association file from the link's own domain, so a mismatch ends
# the login in Safari with the app still waiting. Leave blank to disable the
# mobile auth flow entirely.
MOBILE_CALLBACK_URL=

# Oldest iOS build this server still supports, returned by /api/site-info so
# the app can show a blocking "update required" screen. 0 means no floor. This
# is the escape hatch that makes a breaking API change survivable once builds
# are on people's phones for months; it cannot be added retroactively.
MIN_IOS_BUILD=0
