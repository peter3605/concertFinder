# Copy to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — it holds real config, not example values.

domain                  = "your-domain.example"        # apex you registered
ses_verified_recipient  = "peter.ho433@gmail.com"     # gets the SES sandbox verification email

# Leave false for the first apply. The SES verification token does not exist
# until that apply creates the identity, so the record proving the domain
# cannot be published beforehand — true here on pass 1 would make Terraform
# wait for a record that cannot yet exist. Flip to true (or pass
# `-var ses_dns_records_created=true`) once the records from
# `terraform output dns_records` are live. See infra/README.md.
ses_dns_records_created = false

# The database is NOT here. Postgres is Neon, created once in its console and
# pasted into /opt/concertfinder/.env as DATABASE_URL — see docs/aws-deploy.md
# §1. This Terraform owns only the S3 bucket its nightly dump lands in.

# The subnet the app instance lives in. SET THIS on an existing deployment, to
# the subnet the instance is already in:
#
#   aws ec2 describe-instances --filters Name=tag:Name,Values=concertfinder \
#     --query 'Reservations[].Instances[].SubnetId' --output text
#
# Unset, it falls back to the first ID of the default VPC's subnet list. That
# list is a set, so it has no defined order: the value at index 0 can change
# with nothing in the config changing, and a changed subnet forces Terraform to
# REPLACE the instance -- taking /opt/concertfinder, the rendered .env and the
# caddy certificate volumes with it. `prevent_destroy` on the instance now
# turns that into an error rather than a rebuild, but the error is a stuck
# plan; pinning the value is what avoids it.
# subnet_id = "subnet-0123456789abcdef0"

# Where CloudWatch alarm mail goes. Unset, it reuses ses_verified_recipient
# above -- the same address CONTACT_EMAIL already uses. Set it only if alerts
# should go somewhere other than the operator's own inbox.
#
# An email subscription is PENDING until the recipient clicks the confirmation
# link AWS mails on the first apply. Terraform reports the resource created
# either way, so a green apply is not proof that alerts are deliverable; check
# the subscription reads Confirmed in the SNS console once.
# alert_email = "alerts@example.com"

# Everything else has sensible defaults; override only if needed:
# region                       = "us-east-1"
# github_repo                  = "peter3605/concertFinder"
# github_branch                = "main"
# ec2_instance_type            = "t4g.small"
# ses_notification_local_part  = "notifications"
# backup_retention_days        = 30
# billing_alarm_threshold_usd  = 15

# --- iOS client (docs/aws-deploy.md §7a) ------------------------------------
#
# All optional: left unset the deployment serves the web app unchanged --
# /api/auth/login?client=ios returns 501, apple-app-site-association 404s (on
# purpose; serving one that names an empty app is worse, because iOS caches
# it), and the push worker no-ops. What is not allowed is a PARTIAL APNs set,
# which wires up successfully and then drops every notification silently;
# config.Validate refuses to start on one.
#
# ios_bundle_id    = "com.example.concertfinder"  # explicit App ID, not a wildcard
# ios_team_id      = "ABCDE12345"                 # Apple Developer team
# apns_key_id      = "XYZ9876543"                 # the .p8's key ID
# apns_environment = "sandbox,production"         # what the .p8 is authorized for
# min_ios_build    = 0                            # 0 means no floor
#
# The .p8 itself is NOT a Terraform value -- it is an operator secret, and it
# is in operator_secrets, so `terraform apply` creates the parameter holding
# REPLACE_ME and render-env.sh fails the next deploy until you run
# ./scripts/set-secrets.sh. That applies even if you never ship the app: mark
# it unused with [-] once. Do not apply until you have the key in hand.
