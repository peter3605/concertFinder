# Terraform state — contains the SES SMTP password and the break-glass ED25519
# private key in cleartext. Never commit.
#
# These patterns are recursive, so they also cover bootstrap/, whose state stays
# local on purpose (it cannot store its state in the bucket it creates). Once
# the root module has moved to the S3 backend per backend.tf.example, the
# terraform.tfstate here is a stale copy holding live secrets — delete it rather
# than relying on this file to keep it quiet.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Local variables file — has your real domain, real emails.
terraform.tfvars
*.auto.tfvars

# Provider plugins and lock file cache.
.terraform/
.terraform.lock.hcl.backup

# Break-glass SSH key. Terraform writes this so you have it locally if SSM
# ever dies. Never upload it anywhere.
.secrets/

# Plan output artifacts.
*.tfplan
