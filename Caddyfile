# Domain is injected via env at container start (or hardcode when stable).
# Automatic HTTPS via Let's Encrypt — Caddy provisions the cert on first request.
{$SITE_DOMAIN} {
	encode gzip

	# Response headers for every route, SPA and API alike. `header` IS a
	# site-level directive — unlike `header_up`, which is reverse_proxy-only
	# (see the note below). Applied here rather than in Go so they cover
	# Caddy's own error responses too.
	header {
		# Without HSTS the *first* request a new visitor makes goes out in
		# plaintext on port 80 before the redirect, and is interceptable —
		# which for this app means a session cookie and an OAuth flow guarding
		# encrypted Spotify refresh tokens. includeSubDomains is safe here:
		# the only subdomain in play is mail.<domain>, which exists for SES
		# MAIL FROM (MX and TXT records) and serves no HTTP. Deliberately no
		# `preload` — that one is effectively irreversible.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The API returns attacker-influenced strings (artist and venue names
		# from third-party feeds); nosniff keeps a browser from deciding a
		# JSON response is really HTML.
		X-Content-Type-Options "nosniff"
		# Don't leak the path of an authenticated page to third-party ticket
		# links, which every concert card is full of.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Clickjacking. frame-ancestors is the modern form; X-Frame-Options
		# covers browsers that predate it. This is deliberately NOT a full
		# CSP — restricting script/style sources needs testing against the
		# Vite bundle, and a wrong one breaks the app silently on first load.
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
	}

	# header_up is a reverse_proxy subdirective, NOT a site-level one. Written
	# at site level it is a hard config-adapt error ("unrecognized directive:
	# header_up"), so Caddy refuses to start at all — and with
	# `restart: unless-stopped` that is a crash loop with no TLS and no site,
	# while the api container next to it looks perfectly healthy. Verified with
	# `caddy validate`.
	reverse_proxy api:8080 {
		# Every one of these OVERWRITES whatever the client sent. That matters:
		# chi's RealIP middleware reads True-Client-IP first, then X-Real-IP,
		# then the *first* entry of X-Forwarded-For — and Caddy appends to XFF
		# rather than replacing it. Left alone, any client could set
		# True-Client-IP to a value of its choosing and RemoteAddr would carry
		# it straight into the /api/auth IP rate limiter's bucket key, making
		# the limiter bypassable by rotating a header.
		header_up True-Client-IP    {remote_host}
		header_up X-Real-IP         {remote_host}
		header_up X-Forwarded-For   {remote_host}
		# Preserve original scheme/host so the Go handlers see them correctly.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host  {host}
	}

	log {
		output stdout
		format json
	}
}
