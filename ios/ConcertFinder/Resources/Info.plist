<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The standard bundle keys. Present explicitly because this plist is
	     hand-written rather than generated: without CFBundleIdentifier the
	     simulator refuses to install with "Missing bundle ID". -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleDisplayName</key>
	<string>ConcertFinder</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Two keys, not one, and the ~ipad variant is the point.
	     TARGETED_DEVICE_FAMILY is "1,2", and an iPad app that does not set
	     UIRequiresFullScreen must support all four orientations or Xcode
	     raises "All interface orientations must be supported unless the app
	     requires full screen" -- iPad multitasking can hand a Slide Over or
	     Split View app any of them. Declaring all four on the base key would
	     fix the warning by also letting an iPhone sit upside down, which is
	     not the behaviour wanted; the suffixed key overrides the base one on
	     iPad only.

	     Claiming full screen instead would be the other way out, but it opts
	     the app out of multitasking entirely for a layout that already
	     adapts. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- A real explanation, not the feature's name. App Review rejects
	     "we need your location". -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ConcertFinder uses your location once to find concerts near you. You can also type a city instead, and your location is never tracked in the background.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>ConcertFinder adds a show to your calendar only when you tap "Add to Calendar".</string>
	<!-- The API origin, injected per configuration so a debug build can point
	     at a local server without a code change. -->
	<key>CFAPIBaseURL</key>
	<string>$(CF_API_BASE_URL)</string>
	<!-- The App Store listing's numeric ID, assigned on first submission and
	     therefore empty today. UpdateRequiredView hides its "Open App Store"
	     button while this is empty rather than sending the user to a store
	     page that does not exist, on a screen it does not let them dismiss. -->
	<key>CFAppStoreAppID</key>
	<string>$(CF_APP_STORE_APP_ID)</string>
</dict>
</plist>
